# Database Connection (FastAPI uses asyncpg so postgresql+asyncpg:// prefix is auto-handled or specified)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5473/feature_store

# Redis Connection (either REDIS_URL/REDIS_TOKEN or UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN)
REDIS_URL=redis://redis:6379/0
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Third Party Integrations
GROQ_API_KEY=

# Security & General
SECRET_KEY=supersecretkeyreplaceinproduction
ENVIRONMENT=development
